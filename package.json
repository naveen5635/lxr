{
  "name": "ar-scavenger-hunt",
  "version": "1.0.0",
  "description": "Digital AR Scavenger Hunt for Physical Education Classes",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node --no-warnings index.js",
    "server:dev": "cd server && npx nodemon --exec \"node --no-warnings\" index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "cd server && node seed.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
